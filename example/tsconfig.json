{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": [],
    "strict": true,
    "noEmit": true
  },
  "include": ["src"],
  // Types of `.weft` imports; `tsc` needs `--runExternalCode` to start the mapper.
  "contentMappers": [{ "package": "@weft-ui/content-mapper", "extensions": [".weft"] }]
}
