---
/** The Weft mark: two warp and two weft strands in a plain weave. */
interface Props {
  size?: number;
}
const { size = 24 } = Astro.props;
---

<svg viewBox="0 0 24 24" width={size} height={size} fill="currentColor" aria-hidden="true">
  <rect x="2" y="6" width="10.5" height="4" rx="1"/>
  <rect x="19.5" y="6" width="2.5" height="4" rx="1"/>
  <rect x="2" y="14" width="2.5" height="4" rx="1"/>
  <rect x="11.5" y="14" width="10.5" height="4" rx="1"/>
  <rect x="6" y="2" width="4" height="2.5" rx="1"/>
  <rect x="6" y="11.5" width="4" height="10.5" rx="1"/>
  <rect x="14" y="2" width="4" height="10.5" rx="1"/>
  <rect x="14" y="19.5" width="4" height="2.5" rx="1"/>
</svg>
