# mount
create 1 1  # Language
set 1 0 "Gallery (1)"  # Text.value
create 2 0  # ModeLabel
set 2 0 "F"  # Text.value
attach 1 0 2
create 3 2  # Language:for6
set 3 0 "OAK"  # Text.value
create 4 4  # Language:if5.1
branch 3 0 4
rows 1 1 [3]
attach 0 0 1

# rename the gallery
set 1 0 "Library (1)"  # Text.value

# rename one item
set 3 0 "ELM"  # Text.value

# switch item kind to image
create 5 3  # Language:if5.0
branch 3 0 5

# switch mode to compact
set 2 0 "C"  # Text.value
