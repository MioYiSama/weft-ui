# mount
create 1 0  # Tap
set 1 0 "Rows: 0"  # Text.value
set 1 1 "Buttons: 0"  # Text.value
set 1 2 "Texts: 0"  # Text.value
set 1 3 "tap.png"  # Image.src
set 1 4 "Images: 0"  # Text.value
attach 0 0 1

# tap the row
set 1 0 "Rows: 1"  # Text.value

# tap only the nested button
set 1 1 "Buttons: 1"  # Text.value

# tap only the nested text
set 1 2 "Texts: 1"  # Text.value

# tap the image
set 1 4 "Images: 1"  # Text.value
