# mount
create 1 1  # Language
create 2 0  # ModeLabel
set 2 0 "F"  # Text.value
attach 1 0 2
create 3 2  # Language:for4
create 4 4  # Language:if3.1
branch 3 0 4
rows 1 1 [3]
attach 0 0 1

# switch item kind to image
create 5 3  # Language:if3.0
branch 3 0 5

# switch mode to compact
set 2 0 "C"  # Text.value
