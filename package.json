{
  "name": "weft-ui-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.12",
  "scripts": {
    "build": "pnpm build:wasm && pnpm -r --filter \"./packages/*\" build",
    "build:wasm": "pnpm --filter @weft-ui/compiler build:wasm",
    "gen:protocol": "node protocol/generate.ts",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "test": "pnpm -r --if-present test"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3"
  }
}
