{
  "name": "@weft-ui/vite",
  "version": "0.2.0",
  "description": "Vite plugin that builds Weft UI apps for Web, WeChat, and native platforms",
  "license": "Apache-2.0",
  "homepage": "https://github.com/weft-ui/weft-ui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weft-ui/weft-ui.git",
    "directory": "packages/vite"
  },
  "type": "module",
  "files": [
    "CHANGELOG.md",
    "dist",
    "templates"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm build",
    "test": "vitest run"
  },
  "dependencies": {
    "@weft-ui/compiler": "workspace:*",
    "@weft-ui/runtime": "workspace:*",
    "svg2vectordrawable": "^2.9.1"
  },
  "peerDependencies": {
    "@weft-ui/native-android": "workspace:^",
    "@weft-ui/native-apple": "workspace:^",
    "@weft-ui/native-linux": "workspace:^",
    "@weft-ui/native-windows": "workspace:^",
    "vite": "^8.3.8"
  },
  "peerDependenciesMeta": {
    "@weft-ui/native-android": { "optional": true },
    "@weft-ui/native-apple": { "optional": true },
    "@weft-ui/native-linux": { "optional": true },
    "@weft-ui/native-windows": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@weft-ui/content-mapper": "workspace:*",
    "@weft-ui/native-android": "workspace:*",
    "@weft-ui/native-apple": "workspace:*",
    "@weft-ui/native-linux": "workspace:*",
    "@weft-ui/native-windows": "workspace:*",
    "@weft-ui/platform": "workspace:*",
    "happy-dom": "^21.0.4",
    "typescript": "7.1.0-beta",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
