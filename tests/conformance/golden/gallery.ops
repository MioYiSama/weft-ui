# mount
create 1 1  # Gallery
set 1 0 240  # Row.width
set 1 1 60  # Row.height
set 1 2 4  # Row.padding
set 1 3 "#ace"  # Row.background
set 1 4 6  # Row.gap
set 1 5 false  # Checkbox.checked
set 1 6 "https://example.test/gallery/day.png"  # Image.src
set 1 7 "#135"  # Text.color
set 1 8 14  # Text.size
set 1 9 false  # Text.bold
set 1 10 "Weft"  # Input.value
create 2 0  # Panel
create 3 2  # Gallery:slot10
set 3 0 "Caption: Weft"  # Text.value
attach 2 0 3
set 2 0 "Panel clicks: 0"  # Text.value
attach 1 0 2
attach 0 0 1

# check to show the slot list
set 1 5 true  # Checkbox.checked
create 4 3  # Gallery:if9.0
create 5 4  # Gallery:for8
set 5 0 "First"  # Text.value
create 6 4  # Gallery:for8
set 6 0 "Second"  # Text.value
rows 4 0 [5 6]
branch 3 0 4

# change the image URL
set 1 6 "https://example.test/gallery/night.png"  # Image.src

# change all bound styles
set 1 0 280  # Row.width
set 1 1 80  # Row.height
set 1 2 8  # Row.padding
set 1 3 "#246"  # Row.background
set 1 4 10  # Row.gap
set 1 7 "#fff"  # Text.color
set 1 8 18  # Text.size
set 1 9 true  # Text.bold

# edit the caption in the slot
set 1 10 "New caption"  # Input.value
set 3 0 "Caption: New caption"  # Text.value

# reorder the slot list
rows 4 0 [6 5]

# click the panel button
set 2 0 "Panel clicks: 1"  # Text.value

# uncheck to hide the slot list
set 1 5 false  # Checkbox.checked
branch 3 0 0
