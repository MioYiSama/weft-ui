{
  "name": "example",
  "private": true,
  "type": "module",
  "dependencies": {
    "@weft-ui/platform": "workspace:*",
    "@weft-ui/runtime": "workspace:*",
    "@weft-ui/vite": "workspace:*"
  },
  "devDependencies": {
    "@weft-ui/content-mapper": "workspace:*",
    "typescript": "7.1.0-beta",
    "vite": "^8.3.8"
  },
  "scripts": {
    "build:android": "WEFT_PLATFORM=android vite build",
    "build:ios": "WEFT_PLATFORM=ios vite build",
    "build:linux": "WEFT_PLATFORM=linux vite build",
    "build:macos": "WEFT_PLATFORM=macos vite build",
    "build:web": "WEFT_PLATFORM=web vite build",
    "build:wechat": "WEFT_PLATFORM=wechat vite build",
    "build:windows": "WEFT_PLATFORM=windows vite build",
    "test:android": "apps/android/gradlew -p apps/android connectedDebugAndroidTest",
    "test:ios": "xcodebuild test -project apps/ios/App.xcodeproj -scheme App -destination \"platform=iOS Simulator,name=${WEFT_IOS_DEVICE:-iPhone 17}\" -derivedDataPath apps/ios/build",
    "test:linux": "ctest --test-dir apps/linux/build --output-on-failure",
    "test:macos": "xcodebuild test -project apps/macos/App.xcodeproj -scheme App -destination platform=macOS -derivedDataPath apps/macos/build",
    "test:windows": "dotnet test apps/windows/UITests",
    "typecheck": "tsc --runExternalCode"
  }
}
