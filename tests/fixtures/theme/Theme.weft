theme {
  accent = "#0a84ff" dark "#409cff",
  gap = 8,
}

style Accent { color = theme.accent }
model Model { flag: Bool }

component Badge(tint: Color) {
  Text("badge", color = tint)
}

component Theme(model: Model) {
  Column(gap = theme.gap) {
    Text("accent", style = Accent)
    Text("flag", color = if (model.flag) theme.accent else "#000000")
    Badge(theme.accent)
  }
}
