---
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import { Image } from "astro:assets";
import { Code } from "astro:components";
import githubDark from "@shikijs/themes/github-dark-default";
import githubLight from "@shikijs/themes/github-light-default";
import WeftMark from "./WeftMark.astro";
import { landing, type Lang } from "../i18n/landing";
import { langRedirect } from "../i18n/lang-redirect.mjs";
import weft from "../weft.tmLanguage.json";
import webShot from "../assets/screenshots/web.png";
import wechatShot from "../assets/screenshots/wechat.png";
import iosShot from "../assets/screenshots/ios.png";
import macosShot from "../assets/screenshots/macos.png";
import androidShot from "../assets/screenshots/android.png";
import windowsShot from "../assets/screenshots/windows.png";
import linuxShot from "../assets/screenshots/linux.png";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = landing[lang];
const home = `${t.prefix}/`;
const guides = `${t.prefix}/guides/getting-started/`;
const platformsGuide = `${t.prefix}/guides/platforms/`;
const repo = "https://github.com/weft-ui/weft-ui";
// The specs live in the repository, next to the code that implements them.
const specSuffix = lang === "en" ? "" : ".zh-CN";
const grammar = `${repo}/blob/master/crates/parser/GRAMMAR${specSuffix}.md`;
const protocol = `${repo}/blob/master/protocol/SPEC${specSuffix}.md`;
const command = "WEFT_PLATFORM=ios,android,linux vite build";

const view = `model Todo {
    id: Int,
    name: String,
    done: Bool
}

model Model {
    draft: String,
    todos: Todo[]
}

event Draft(value: String)
event Add
event Toggle(id: Int)

component App(model: Model) {
    Column(padding = 16, gap = 12) {
        Row(gap = 8) {
            Input(model.draft, onChange = Draft)
            Button(onClick = Add) {
                Text("Add")
            }
        }

        for (todo in model.todos; key = todo.id) {
            Row(gap = 8) {
                Checkbox(todo.done, onChange = Toggle(todo.id))
                Text(todo.name)
            }
        }

        Text("\${model.todos.length} todos", color = "#6b7280")
    }
}`;

const logic = `import { App } from "./App.weft";
import { run } from "@weft-ui/platform";

const app = new App({ draft: "", todos: [] });
let nextId = 1;

app.onDraft((model, { value }) => {
  model.draft = value;
});

app.onAdd((model) => {
  const name = model.draft.trim();
  if (!name) return;
  model.todos = [...model.todos, { id: nextId++, name, done: false }];
  model.draft = "";
});

app.onToggle((model, { id }) => {
  const todo = model.todos.find((t) => t.id === id);
  if (todo) todo.done = !todo.done;
});

run(app);`;

// Theme objects rather than names: the prerender bundle drops Shiki's theme registry.
const themes = { light: githubLight, dark: githubDark };

const platforms = [
  { id: "web", view: "DOM", engine: t.platforms.browser, tool: "Vite" },
  { id: "wechat", view: "WXML", engine: t.platforms.miniProgram, tool: t.platforms.devTools },
  { id: "ios", view: "SwiftUI", engine: "Hermes", tool: "xcodebuild", min: "iOS 17" },
  { id: "macos", view: "SwiftUI", engine: "Hermes", tool: "xcodebuild", min: "macOS 14" },
  { id: "android", view: "Jetpack Compose", engine: "Hermes", tool: "Gradle", min: "API 24" },
  { id: "windows", view: "WinUI 3", engine: "Hermes", tool: "dotnet build", min: "10 1809" },
  { id: "linux", view: "GTK 4", engine: "Hermes", tool: "CMake", min: "GTK 4.10" },
];

// Screenshots of example/ on each platform, in the order of `platforms`. Phones are
// cropped to the top of the screen; desktop shots are 2x captures of the window.
const shots = {
  web: { name: "Web", kind: "browser", src: webShot },
  wechat: { name: t.showcase.wechat, kind: "phone", src: wechatShot },
  ios: { name: "iOS", kind: "phone", src: iosShot },
  macos: { name: "macOS", kind: "window", src: macosShot },
  android: { name: "Android", kind: "phone", src: androidShot },
  windows: { name: "Windows", kind: "window", src: windowsShot },
  linux: { name: "Linux", kind: "window", src: linuxShot },
} as const;
const slides = platforms.map((p) => ({ id: p.id, view: p.view, ...shots[p.id as keyof typeof shots] }));

// Icons in the order of `t.features.items`.
const icons = [
  '<path d="m12 2 10 5-10 5L2 7z"/><path d="m2 17 10 5 10-5"/><path d="m2 12 10 5 10-5"/>',
  '<path d="M13 2 3 14h9l-1 8 10-12h-9z"/>',
  '<path d="m17 2 4 4-4 4"/><path d="M3 11v-1a4 4 0 0 1 4-4h14"/><path d="m7 22-4-4 4-4"/><path d="M21 13v1a4 4 0 0 1-4 4H3"/>',
  '<path d="m16 18 6-6-6-6"/><path d="m8 6-6 6 6 6"/>',
  '<path d="M12 22v-5"/><path d="M9 8V2"/><path d="M15 8V2"/><path d="M18 8v5a4 4 0 0 1-4 4h-4a4 4 0 0 1-4-4V8z"/>',
  '<path d="m4 17 6-6-6-6"/><path d="M12 19h8"/>',
];
const features = t.features.items.map((item, i) => ({ ...item, icon: icons[i] }));
const steps = t.steps.items.map((item, i) => ({ ...item, n: String(i + 1).padStart(2, "0") }));

const github =
  "M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline set:html={langRedirect} />
    <title>{t.title}</title>
    <meta name="description" content={t.description} />
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(home, Astro.site)} />
    <link rel="alternate" hreflang={lang} href={new URL(home, Astro.site)} />
    <link rel="alternate" hreflang={t.other.lang} href={new URL(t.other.href, Astro.site)} />
    <script is:inline>
      // Same storage key as Starlight's theme picker, so both stay in sync.
      (() => {
        const stored = localStorage.getItem("starlight-theme");
        const theme =
          stored === "light" || stored === "dark"
            ? stored
            : matchMedia("(prefers-color-scheme: light)").matches
              ? "light"
              : "dark";
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <header class="nav">
      <div class="nav-inner">
        <a class="brand" href={home}>
          <WeftMark size={22} />
          <span>Weft UI</span>
        </a>
        <nav class="links">
          <a href={guides}>{t.nav.guides}</a>
          <a href={grammar}>{t.nav.grammar}</a>
          <a href={protocol}>{t.nav.protocol}</a>
        </nav>
        <div class="nav-actions">
          <a class="lang-link" href={t.other.href} hreflang={t.other.lang} lang={t.other.lang}>{t.other.label}</a>
          <a class="icon-link" href={repo} aria-label="GitHub">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d={github} /></svg>
          </a>
          <a class="btn btn-primary btn-sm" href={guides}>{t.nav.docs}</a>
        </div>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="hero-grid" aria-hidden="true"></div>
        <div class="hero-glow" aria-hidden="true"></div>
        <div class="container hero-content">
          <a class="pill" href={platformsGuide}>
            <span class="pill-dot"></span>
            {t.pill}
            <span class="pill-arrow">→</span>
          </a>
          <h1>{t.headline[0]}<br />{t.headline[1]}</h1>
          <p class="lead">{t.lead[0]} <code>.weft</code>{lang === "en" ? "" : " "}{t.lead[1]}</p>
          <div class="cta">
            <a class="btn btn-primary" href={guides}>{t.start} <span aria-hidden="true">→</span></a>
            <a class="btn btn-secondary" href={repo}>
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d={github} /></svg>
              GitHub
            </a>
          </div>
          <div class="command">
            <span class="prompt">$</span>
            <code>{command}</code>
            <button class="copy" type="button" data-copy={command} aria-label={t.copy}>
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" /><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" /></svg>
            </button>
          </div>
        </div>
      </section>

      <section class="container section">
        <div class="window">
          <div class="window-pane">
            <div class="tab"><span class="tab-dot weft"></span>App.weft</div>
            <Code code={view} lang={weft as any} themes={themes} defaultColor={false} />
          </div>
          <div class="window-pane">
            <div class="tab"><span class="tab-dot ts"></span>index.ts</div>
            <Code code={logic} lang="ts" themes={themes} defaultColor={false} />
          </div>
        </div>
        <p class="caption">{t.caption[0]} <code>.weft</code>{lang === "en" ? "" : " "}{t.caption[1]}</p>
      </section>

      <section class="container section" data-carousel>
        <div class="section-head">
          <p class="eyebrow">{t.showcase.eyebrow}</p>
          <h2>{t.showcase.heading}</h2>
          <p class="sub">{t.showcase.sub}</p>
        </div>
        <div class="shot-tabs" role="tablist" aria-label={t.showcase.heading}>
          {
            slides.map((s, i) => (
              <button
                type="button"
                role="tab"
                class="shot-tab"
                id={`shot-tab-${s.id}`}
                aria-controls={`shot-${s.id}`}
                aria-selected={i === 0 ? "true" : "false"}
                tabindex={i === 0 ? 0 : -1}
              >
                <span class="shot-name">{s.name}</span>
                <span class="shot-view">{s.view}</span>
                <span class="shot-progress" aria-hidden="true" />
              </button>
            ))
          }
        </div>
        <div class="stage">
          <div class="stage-track" data-track>
            {
              slides.map((s, i) => (
                <div
                  class={`slide slide-${s.kind}`}
                  role="tabpanel"
                  id={`shot-${s.id}`}
                  aria-labelledby={`shot-tab-${s.id}`}
                  inert={i !== 0}
                >
                  <div class={`frame frame-${s.kind}`}>
                    {s.kind === "browser" && (
                      <div class="browser-bar" aria-hidden="true">
                        <span class="browser-dot" />
                        <span class="browser-dot" />
                        <span class="browser-dot" />
                        <span class="browser-url">localhost:5173</span>
                      </div>
                    )}
                    <Image
                      src={s.src}
                      width={s.kind === "phone" ? 360 : Math.round(s.src.width / 2)}
                      densities={[1, 2]}
                      alt={`${t.showcase.alt[0]}${s.name}${t.showcase.alt[1]}`}
                      loading="eager"
                    />
                  </div>
                </div>
              ))
            }
          </div>
          <button class="stage-button stage-prev" type="button" data-step="-1" aria-label={t.showcase.prev}>
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
          </button>
          <button class="stage-button stage-next" type="button" data-step="1" aria-label={t.showcase.next}>
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
          </button>
          <button class="stage-button stage-pause" type="button" data-pause data-label-pause={t.showcase.pause} data-label-play={t.showcase.play} aria-label={t.showcase.pause}>
            <svg class="icon-pause" viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1" /><rect x="14" y="5" width="4" height="14" rx="1" /></svg>
            <svg class="icon-play" viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M7 4.5v15a1 1 0 0 0 1.5.86l12.5-7.5a1 1 0 0 0 0-1.72L8.5 3.64A1 1 0 0 0 7 4.5z" /></svg>
          </button>
        </div>
      </section>

      <section class="container section">
        <div class="section-head">
          <p class="eyebrow">{t.platforms.eyebrow}</p>
          <h2>{t.platforms.heading}</h2>
          <p class="sub">{t.platforms.sub}</p>
        </div>
        <div class="platforms">
          {
            platforms.map((p) => (
              <div class="platform">
                <div class="platform-top">
                  <code class="tag">{p.id}</code>
                  {p.min && <span class="min">{p.min}</span>}
                </div>
                <div class="platform-view">{p.view}</div>
                <div class="platform-meta">
                  {p.engine} · {p.tool}
                </div>
              </div>
            ))
          }
          <a class="platform platform-link" href={protocol}>
            <div class="platform-view">{t.platforms.protocol.title}</div>
            <div class="platform-meta">{t.platforms.protocol.body}</div>
          </a>
        </div>
      </section>

      <section class="container section">
        <div class="section-head">
          <p class="eyebrow">{t.features.eyebrow}</p>
          <h2>{t.features.heading}</h2>
          <p class="sub">{t.features.sub}</p>
        </div>
        <div class="features">
          {
            features.map((f) => (
              <div class="feature">
                <svg class="feature-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={f.icon} />
                <h3>{f.title}</h3>
                <p>{f.body}</p>
              </div>
            ))
          }
        </div>
      </section>

      <section class="container section">
        <div class="section-head">
          <p class="eyebrow">{t.steps.eyebrow}</p>
          <h2>{t.steps.heading}</h2>
        </div>
        <ol class="steps">
          {
            steps.map((s) => (
              <li class="step">
                <span class="step-n">{s.n}</span>
                <h3>{s.title}</h3>
                <p>{s.body}</p>
                <code>{s.code}</code>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="container final">
        <div class="final-inner">
          <WeftMark size={40} />
          <h2>{t.final.heading}</h2>
          <p class="sub">{t.final.sub}</p>
          <div class="cta">
            <a class="btn btn-primary" href={guides}>{t.final.primary}</a>
            <a class="btn btn-secondary" href={`${repo}/tree/master/example`}>{t.final.secondary}</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="container footer-inner">
        <a class="brand" href={home}>
          <WeftMark size={18} />
          <span>Weft UI</span>
        </a>
        <nav class="footer-links">
          <a href={guides}>{t.nav.guides}</a>
          <a href={grammar}>{t.nav.grammar}</a>
          <a href={protocol}>{t.nav.protocol}</a>
          <a href={repo}>GitHub</a>
        </nav>
        <div class="theme-switch" role="radiogroup" aria-label={t.theme.label}>
          <button type="button" data-theme-choice="light" aria-label={t.theme.light}>
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
          </button>
          <button type="button" data-theme-choice="auto" aria-label={t.theme.auto}>
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2" /><path d="M8 21h8M12 17v4" /></svg>
          </button>
          <button type="button" data-theme-choice="dark" aria-label={t.theme.dark}>
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9z" /></svg>
          </button>
        </div>
      </div>
    </footer>

    <script>
      for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
        button.addEventListener("click", async () => {
          await navigator.clipboard.writeText(button.dataset.copy!);
          button.classList.add("copied");
          setTimeout(() => button.classList.remove("copied"), 1200);
        });
      }

      const light = matchMedia("(prefers-color-scheme: light)");
      const choices = document.querySelectorAll<HTMLButtonElement>("[data-theme-choice]");
      const apply = () => {
        const stored = localStorage.getItem("starlight-theme");
        const choice = stored === "light" || stored === "dark" ? stored : "auto";
        document.documentElement.dataset.theme = choice === "auto" ? (light.matches ? "light" : "dark") : choice;
        for (const c of choices) c.setAttribute("aria-checked", String(c.dataset.themeChoice === choice));
      };
      for (const c of choices) {
        c.setAttribute("role", "radio");
        c.addEventListener("click", () => {
          const choice = c.dataset.themeChoice!;
          localStorage.setItem("starlight-theme", choice === "auto" ? "" : choice);
          apply();
        });
      }
      light.addEventListener("change", apply);
      apply();

      // Screenshot carousel. The active tab's progress bar is a CSS animation; when it ends, the
      // next slide shows. Hover, keyboard focus, the pause button and leaving the viewport pause it.
      const still = matchMedia("(prefers-reduced-motion: reduce)");
      for (const root of document.querySelectorAll<HTMLElement>("[data-carousel]")) {
        const track = root.querySelector<HTMLElement>("[data-track]")!;
        const slides = Array.from(track.children) as HTMLElement[];
        const list = root.querySelector<HTMLElement>('[role="tablist"]')!;
        const tabs = Array.from(list.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
        const pause = root.querySelector<HTMLButtonElement>("[data-pause]")!;
        let index = 0;

        const show = (next: number, scroll = true) => {
          index = (next + slides.length) % slides.length;
          tabs.forEach((tab, i) => {
            tab.setAttribute("aria-selected", String(i === index));
            tab.tabIndex = i === index ? 0 : -1;
          });
          slides.forEach((slide, i) => (slide.inert = i !== index));
          const behavior = still.matches ? "auto" : "smooth";
          if (scroll) track.scrollTo({ left: index * track.clientWidth, behavior });
          // Narrow screens scroll the tab row; keep the active tab in it.
          const tab = tabs[index];
          if (list.scrollWidth > list.clientWidth) {
            list.scrollTo({ left: tab.offsetLeft - (list.clientWidth - tab.offsetWidth) / 2, behavior });
          }
        };

        const setPaused = (paused: boolean) => {
          root.toggleAttribute("data-paused", paused);
          pause.setAttribute("aria-label", paused ? pause.dataset.labelPlay! : pause.dataset.labelPause!);
        };

        tabs.forEach((tab, i) => {
          tab.addEventListener("click", () => show(i));
          tab.addEventListener("animationend", () => show(index + 1));
          tab.addEventListener("keydown", (event) => {
            const step = { ArrowLeft: -1, ArrowRight: 1 }[event.key];
            const target = event.key === "Home" ? 0 : event.key === "End" ? tabs.length - 1 : step && index + step;
            if (target === undefined) return;
            event.preventDefault();
            show(target);
            tabs[index].focus();
          });
        });
        for (const button of root.querySelectorAll<HTMLButtonElement>("[data-step]")) {
          button.addEventListener("click", () => show(index + Number(button.dataset.step)));
        }
        pause.addEventListener("click", () => setPaused(!root.hasAttribute("data-paused")));

        // Swipes and trackpad scrolls snap to a slide; follow them once the scroll settles.
        let settle: ReturnType<typeof setTimeout>;
        track.addEventListener("scroll", () => {
          clearTimeout(settle);
          settle = setTimeout(() => {
            const landed = Math.round(track.scrollLeft / track.clientWidth);
            if (landed !== index) show(landed, false);
          }, 100);
        });

        new IntersectionObserver(([entry]) => root.toggleAttribute("data-away", !entry.isIntersecting)).observe(root);
        setPaused(still.matches);
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #000;
    --fg: #ededed;
    --muted: #a1a1a1;
    --subtle: #707070;
    --border: #262626;
    --border-strong: #3d3d3d;
    --surface: #0a0a0a;
    --surface-hover: #111;
    --btn-bg: #ededed;
    --btn-fg: #0a0a0a;
    --grid: rgb(255 255 255 / 0.07);
    --glow-opacity: 0.5;
    color-scheme: dark;
  }

  :root[data-theme="light"] {
    --bg: #fff;
    --fg: #0a0a0a;
    --muted: #666;
    --subtle: #8f8f8f;
    --border: #ebebeb;
    --border-strong: #d4d4d4;
    --surface: #fafafa;
    --surface-hover: #f2f2f2;
    --btn-bg: #0a0a0a;
    --btn-fg: #fff;
    --grid: rgb(0 0 0 / 0.06);
    --glow-opacity: 0.35;
    color-scheme: light;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

