<Project Sdk="Microsoft.NET.Sdk">

  <!-- UI tests of the app through UI Automation (FlaUI); run with
       `dotnet test UITests` from an interactive desktop session after building the app. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Where the app project builds App.exe. -->
    <AssemblyMetadata Include="AppProject" Value="$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..'))" />
    <PackageReference Include="FlaUI.UIA3" Version="5.0.0" />
    <PackageReference Include="MSTest" Version="4.5.3" />
  </ItemGroup>

</Project>
