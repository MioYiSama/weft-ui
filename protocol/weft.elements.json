{
  "unions": {
    "CrossAlign": ["start", "center", "end", "stretch"],
    "Justify": ["start", "center", "end", "spaceBetween", "spaceAround", "spaceEvenly"],
    "Alignment": ["topStart", "top", "topEnd", "start", "center", "end", "bottomStart", "bottom", "bottomEnd"],
    "Axis": ["vertical", "horizontal"],
    "Shadow": ["none", "small", "medium", "large"],
    "Weight": ["regular", "light", "medium", "semibold", "bold"],
    "TextAlign": ["start", "center", "end"],
    "Decoration": ["none", "underline", "lineThrough"]
  },
  "groups": {
    "layout": [
      {
        "name": "width", "type": "Int", "css": { "property": "width", "unit": "px" },
        "doc": { "en": "Sets the width of the content box.", "zh": "设置内容盒的宽度。" }
      },
      {
        "name": "height", "type": "Int", "css": { "property": "height", "unit": "px" },
        "doc": { "en": "Sets the height of the content box.", "zh": "设置内容盒的高度。" }
      },
      {
        "name": "grow", "type": "Float", "default": 0, "css": { "unit": "custom", "custom": "grow" },
        "doc": { "en": "Sets the share of remaining main-axis space for a child in a linear container.", "zh": "设置子元素在线性容器主轴上分得剩余空间的比例。" }
      },
      {
        "name": "minWidth", "type": "Int", "css": { "property": "min-width", "unit": "px" },
        "doc": { "en": "Sets the minimum content width.", "zh": "设置内容宽度的下限。" }
      },
      {
        "name": "maxWidth", "type": "Int", "css": { "property": "max-width", "unit": "px" },
        "doc": { "en": "Sets the maximum content width.", "zh": "设置内容宽度的上限。" }
      },
      {
        "name": "minHeight", "type": "Int", "css": { "property": "min-height", "unit": "px" },
        "doc": { "en": "Sets the minimum content height.", "zh": "设置内容高度的下限。" }
      },
      {
        "name": "maxHeight", "type": "Int", "css": { "property": "max-height", "unit": "px" },
        "doc": { "en": "Sets the maximum content height.", "zh": "设置内容高度的上限。" }
      },
      {
        "name": "fill", "type": "Bool", "default": false, "css": { "unit": "custom", "custom": "fill" },
        "doc": { "en": "Fills the cross axis in a linear container or both axes in a Stack.", "zh": "在线性容器中撑满交叉轴，或在 Stack 中撑满两个轴。" }
      },
      {
        "name": "aspectRatio", "type": "Float", "css": { "property": "aspect-ratio", "unit": "number" },
        "doc": { "en": "Sets width divided by height when one dimension determines the other.", "zh": "在由一边推算另一边时指定宽高比。" }
      },
      {
        "name": "margin", "type": "Int", "default": 0,
        "css": { "properties": ["margin-top", "margin-right", "margin-bottom", "margin-left"], "unit": "px" },
        "doc": { "en": "Sets the outer spacing on all four sides.", "zh": "设置四边的外边距。" }
      },
      {
        "name": "marginX", "type": "Int", "default": 0,
        "css": { "properties": ["margin-left", "margin-right"], "unit": "px" },
        "doc": { "en": "Sets the outer spacing on the left and right.", "zh": "设置左右外边距。" }
      },
      {
        "name": "marginY", "type": "Int", "default": 0,
        "css": { "properties": ["margin-top", "margin-bottom"], "unit": "px" },
        "doc": { "en": "Sets the outer spacing on the top and bottom.", "zh": "设置上下外边距。" }
      },
      {
        "name": "marginTop", "type": "Int", "default": 0, "css": { "property": "margin-top", "unit": "px" },
        "doc": { "en": "Sets the top margin.", "zh": "设置上外边距。" }
      },
      {
        "name": "marginBottom", "type": "Int", "default": 0, "css": { "property": "margin-bottom", "unit": "px" },
        "doc": { "en": "Sets the bottom margin.", "zh": "设置下外边距。" }
      },
      {
        "name": "marginStart", "type": "Int", "default": 0, "css": { "property": "margin-left", "unit": "px" },
        "doc": { "en": "Sets the left margin in left-to-right layout.", "zh": "设置从左到右布局中的左外边距。" }
      },
      {
        "name": "marginEnd", "type": "Int", "default": 0, "css": { "property": "margin-right", "unit": "px" },
        "doc": { "en": "Sets the right margin in left-to-right layout.", "zh": "设置从左到右布局中的右外边距。" }
      }
    ],
    "visibility": [
      {
        "name": "opacity", "type": "Float", "default": 1,
        "css": { "property": "opacity", "unit": "number" },
        "doc": { "en": "Sets the opacity of the element and its children.", "zh": "设置整个元素及其子元素的不透明度。" }
      },
      {
        "name": "hidden", "type": "Bool", "default": false,
        "css": { "unit": "custom", "custom": "hidden" },
        "doc": { "en": "Hides the element and removes it from layout.", "zh": "隐藏元素，使其不参与布局。" }
      }
    ],
    "padding": [
      {
        "name": "padding", "type": "Int", "default": 0,
        "css": { "properties": ["padding-top", "padding-right", "padding-bottom", "padding-left"], "unit": "px" },
        "doc": { "en": "Sets the inset on all four sides.", "zh": "设置四边的内边距。" }
      },
      {
        "name": "paddingX", "type": "Int", "default": 0,
        "css": { "properties": ["padding-left", "padding-right"], "unit": "px" },
        "doc": { "en": "Sets the left and right insets.", "zh": "设置左右内边距。" }
      },
      {
        "name": "paddingY", "type": "Int", "default": 0,
        "css": { "properties": ["padding-top", "padding-bottom"], "unit": "px" },
        "doc": { "en": "Sets the top and bottom insets.", "zh": "设置上下内边距。" }
      },
      {
        "name": "paddingTop", "type": "Int", "default": 0, "css": { "property": "padding-top", "unit": "px" },
        "doc": { "en": "Sets the top inset.", "zh": "设置上内边距。" }
      },
      {
        "name": "paddingBottom", "type": "Int", "default": 0, "css": { "property": "padding-bottom", "unit": "px" },
        "doc": { "en": "Sets the bottom inset.", "zh": "设置下内边距。" }
      },
      {
        "name": "paddingStart", "type": "Int", "default": 0, "css": { "property": "padding-left", "unit": "px" },
        "doc": { "en": "Sets the left inset in left-to-right layout.", "zh": "设置从左到右布局中的左内边距。" }
      },
      {
        "name": "paddingEnd", "type": "Int", "default": 0, "css": { "property": "padding-right", "unit": "px" },
        "doc": { "en": "Sets the right inset in left-to-right layout.", "zh": "设置从左到右布局中的右内边距。" }
      }
    ],
    "decoration": [
      {
        "name": "background", "type": "Color",
        "css": { "property": "background-color", "unit": "color" },
        "doc": { "en": "Fills the padding box, including the area underneath the border.", "zh": "为内边距盒填充背景色，边框下方也会着色。" }
      },
      {
        "name": "radius", "type": "Int", "default": 0,
        "css": { "property": "border-radius", "unit": "px" },
        "doc": { "en": "Rounds the corners of the background and border.", "zh": "为背景和边框设置圆角。" }
      },
      {
        "name": "border", "type": "Int", "default": 0,
        "css": { "unit": "custom", "custom": "border" },
        "doc": { "en": "Draws a solid border of the given width outside the padding box.", "zh": "在内边距盒外绘制指定宽度的实线边框。" }
      },
      {
        "name": "borderColor", "type": "Color", "default": "#0000001f",
        "css": { "property": "border-color", "unit": "color" },
        "doc": { "en": "Sets the border color; the dark-mode default is `#ffffff26`.", "zh": "设置边框颜色；深色模式默认使用 `#ffffff26`。" }
      },
      {
        "name": "shadow", "type": "Shadow", "default": "none",
        "css": { "unit": "custom", "custom": "shadow" },
        "doc": { "en": "Draws a preset shadow outside the border box.", "zh": "在边框盒外绘制预设阴影。" }
      },
      {
        "name": "clip", "type": "Bool", "default": false,
        "css": { "property": "overflow", "unit": "keyword", "keywords": { "true": "hidden", "false": "visible" } },
        "doc": { "en": "Clips overflowing content to the rounded padding box.", "zh": "将溢出的内容裁剪到带圆角的内边距盒内。" }
      }
    ],
    "text": [
      {
        "name": "color", "type": "Color",
        "css": { "property": "color", "unit": "color" },
        "doc": { "en": "Sets the text color.", "zh": "设置文字颜色。" }
      },
      {
        "name": "size", "type": "Int",
        "css": { "property": "font-size", "unit": "px" },
        "doc": { "en": "Sets the font size in logical pixels.", "zh": "用逻辑像素设置字号。" }
      },
      {
        "name": "weight", "type": "Weight", "default": "regular",
        "css": { "property": "font-weight", "unit": "keyword", "keywords": { "light": "300", "regular": "400", "medium": "500", "semibold": "600", "bold": "700" } },
        "doc": { "en": "Sets the font weight.", "zh": "设置字重。" }
      },
      {
        "name": "italic", "type": "Bool", "default": false,
        "css": { "property": "font-style", "unit": "keyword", "keywords": { "true": "italic", "false": "normal" } },
        "doc": { "en": "Sets the text in italics.", "zh": "设置斜体。" }
      },
      {
        "name": "decoration", "type": "Decoration", "default": "none",
        "css": { "property": "text-decoration-line", "unit": "keyword", "keywords": { "lineThrough": "line-through" } },
        "doc": { "en": "Underlines or strikes through the text.", "zh": "为文字添加下划线或删除线。" }
      }
    ]
  },
  "features": {
    "theme": {
      "doc": { "en": "Theme declarations and color tokens.", "zh": "主题声明和颜色令牌。" }
    },
    "assets": {
      "doc": { "en": "Local image assets and custom fonts.", "zh": "本地图片资源和自定义字体。" }
    }
  },
  "elements": [
    {
      "name": "Column",
      "doc": { "en": "Stacks children vertically.", "zh": "将子节点纵向排列。" },
      "groups": ["layout", "visibility", "padding", "decoration"],
      "memberSupport": { "padding": {}, "width": {}, "height": {}, "background": {} },
      "children": "any",
      "members": [
        {
          "name": "gap", "type": "Int", "default": 0, "css": { "property": "gap", "unit": "px" },
          "doc": { "en": "Adds space between neighboring children.", "zh": "设置相邻子节点之间的距离。" }
        },
        {
          "name": "align", "type": "CrossAlign", "default": "start",
          "css": { "property": "align-items", "unit": "keyword", "keywords": { "start": "flex-start", "end": "flex-end" } },
          "doc": { "en": "Positions children on the horizontal cross axis.", "zh": "设置子元素在水平交叉轴上的位置。" }
        },
        {
          "name": "justify", "type": "Justify", "default": "start",
          "css": { "property": "justify-content", "unit": "keyword", "keywords": { "start": "flex-start", "end": "flex-end", "spaceBetween": "space-between", "spaceAround": "space-around", "spaceEvenly": "space-evenly" } },
          "doc": { "en": "Distributes remaining space on the vertical main axis.", "zh": "分配纵向主轴上的剩余空间。" }
        }
      ]
    },
    {
      "name": "Row",
      "doc": { "en": "Places children side by side.", "zh": "将子节点横向排列。" },
      "groups": ["layout", "visibility", "padding", "decoration"],
      "memberSupport": { "padding": {}, "width": {}, "height": {}, "background": {} },
      "children": "any",
      "members": [
        {
          "name": "gap", "type": "Int", "default": 0, "css": { "property": "gap", "unit": "px" },
          "doc": { "en": "Adds space between neighboring children.", "zh": "设置相邻子节点之间的距离。" }
        },
        {
          "name": "align", "type": "CrossAlign", "default": "start",
          "css": { "property": "align-items", "unit": "keyword", "keywords": { "start": "flex-start", "end": "flex-end" } },
          "doc": { "en": "Positions children on the vertical cross axis.", "zh": "设置子元素在纵向交叉轴上的位置。" }
        },
        {
          "name": "justify", "type": "Justify", "default": "start",
          "css": { "property": "justify-content", "unit": "keyword", "keywords": { "start": "flex-start", "end": "flex-end", "spaceBetween": "space-between", "spaceAround": "space-around", "spaceEvenly": "space-evenly" } },
          "doc": { "en": "Distributes remaining space on the horizontal main axis.", "zh": "分配横向主轴上的剩余空间。" }
        }
      ]
    },
    {
      "name": "Text",
      "doc": { "en": "Displays plain text or a sequence of styled spans.", "zh": "显示纯文本或由多个行内片段组成的文本。" },
      "groups": ["layout", "visibility", "padding", "decoration", "text"],
      "memberSupport": { "color": {}, "size": {} },
      "children": ["Span"],
      "content": "value",
      "members": [
        {
          "name": "value", "type": "String", "positional": true,
          "doc": { "en": "The plain text to display; required unless `Span` children provide the content.", "zh": "要显示的纯文本；没有 `Span` 子元素时必填。" }
        },
        {
          "name": "align", "type": "TextAlign", "default": "start",
          "css": { "property": "text-align", "unit": "keyword", "keywords": {} },
          "doc": { "en": "Aligns lines within the text box.", "zh": "设置各行文字在文本框中的对齐方式。" }
        },
        {
          "name": "maxLines", "type": "Int", "default": 0,
          "css": { "unit": "custom", "custom": "maxLines" },
          "doc": { "en": "Truncates overflowing lines with an ellipsis; zero or less leaves the text unlimited.", "zh": "超出行数限制时在末尾显示省略号；小于或等于零表示不限行数。" }
        },
        {
          "name": "lineHeight", "type": "Int",
          "css": { "property": "line-height", "unit": "px" },
          "doc": { "en": "Sets the line height in logical pixels.", "zh": "用逻辑像素设置行高。" }
        },
        {
          "name": "bold", "type": "Bool",
          "css": { "property": "font-weight", "unit": "keyword", "keywords": { "true": "bold", "false": "normal" } },
          "doc": { "en": "Displays the text in bold.", "zh": "以粗体显示文本。" }
        }
      ]
    },
    {
      "name": "Span",
      "doc": { "en": "Displays an inline run of text with its own styling.", "zh": "显示可单独设置样式的行内文本片段。" },
      "groups": ["text"],
      "parents": ["Text"],
      "members": [
        {
          "name": "value", "type": "String", "positional": true, "required": true,
          "doc": { "en": "The text of this run.", "zh": "此片段的文字。" }
        }
      ]
    },
    {
      "name": "Button",
      "groups": ["layout", "visibility"],
      "doc": { "en": "Renders a clickable control with child nodes for its content.", "zh": "显示可点击的控件，用子节点提供按钮内容。" },
      "children": "any",
      "members": [
        {
          "name": "onClick",
          "event": true,
          "doc": { "en": "Fires when the button is clicked.", "zh": "按钮被点击时触发。" }
        },
        {
          "name": "disabled",
          "type": "Bool",
          "doc": { "en": "Disables the button.", "zh": "禁用按钮。" }
        }
      ]
    },
    {
      "name": "Input",
      "groups": ["layout", "visibility"],
      "doc": { "en": "Displays an editable text field.", "zh": "显示可编辑的文本框。" },
      "members": [
        {
          "name": "value",
          "type": "String",
          "positional": true,
          "required": true,
          "controlledBy": "onChange",
          "doc": { "en": "The current text.", "zh": "当前输入的文本。" }
        },
        {
          "name": "onChange",
          "event": true,
          "payload": "String",
          "doc": { "en": "Reports the new text after an edit.", "zh": "编辑后提供修改后的文本。" }
        },
        {
          "name": "placeholder",
          "type": "String",
          "doc": { "en": "Shows a hint when the field is empty.", "zh": "输入框为空时显示提示文字。" }
        },
        {
          "name": "disabled",
          "type": "Bool",
          "doc": { "en": "Disables the input field.", "zh": "禁用输入框。" }
        }
      ]
    },
    {
      "name": "Checkbox",
      "groups": ["layout", "visibility"],
      "doc": { "en": "Displays a checkable control.", "zh": "显示可勾选的控件。" },
      "members": [
        {
          "name": "checked",
          "type": "Bool",
          "positional": true,
          "required": true,
          "controlledBy": "onChange",
          "doc": { "en": "The current checked state.", "zh": "当前的选中状态。" }
        },
        {
          "name": "onChange",
          "event": true,
          "payload": "Bool",
          "doc": { "en": "Reports the new checked state.", "zh": "提供修改后的选中状态。" }
        },
        {
          "name": "disabled",
          "type": "Bool",
          "doc": { "en": "Disables the checkbox.", "zh": "禁用复选框。" }
        }
      ]
    },
    {
      "name": "Image",
      "doc": { "en": "Displays an image from a URL.", "zh": "显示指定 URL 的图片。" },
      "groups": ["layout", "visibility", "decoration"],
      "memberSupport": { "width": {}, "height": {} },
      "members": [
        {
          "name": "src",
          "type": "String",
          "positional": true,
          "required": true,
          "doc": { "en": "The image URL.", "zh": "图片的 URL。" }
        }
      ]
    },
    {
      "name": "Stack",
      "doc": { "en": "Overlays children in declaration order.", "zh": "按声明顺序叠放子元素。" },
      "groups": ["layout", "visibility", "padding", "decoration"],
      "children": "any",
      "members": [
        {
          "name": "alignment", "type": "Alignment", "default": "topStart",
          "css": { "property": "place-items", "unit": "keyword", "keywords": {
            "topStart": "start start", "top": "start center", "topEnd": "start end",
            "start": "center start", "center": "center center", "end": "center end",
            "bottomStart": "end start", "bottom": "end center", "bottomEnd": "end end"
          } },
          "doc": { "en": "Positions children along both axes of the stack.", "zh": "设置子元素在堆叠容器两个轴上的位置。" }
        }
      ]
    },
    {
      "name": "Scroll",
      "doc": { "en": "Lays out children linearly and scrolls along its main axis.", "zh": "线性排列子元素，并可沿主轴滚动。" },
      "groups": ["layout", "visibility", "padding", "decoration"],
      "children": "any",
      "members": [
        {
          "name": "direction", "type": "Axis", "constant": true, "default": "vertical",
          "doc": { "en": "Selects the scrolling axis at compile time.", "zh": "在编译时选择滚动轴。" }
        },
        {
          "name": "gap", "type": "Int", "default": 0, "css": { "property": "gap", "unit": "px" },
          "doc": { "en": "Adds space between neighboring children.", "zh": "设置相邻子节点之间的距离。" }
        },
        {
          "name": "align", "type": "CrossAlign", "default": "start",
          "css": { "property": "align-items", "unit": "keyword", "keywords": { "start": "flex-start", "end": "flex-end" } },
          "doc": { "en": "Positions children on the non-scrolling cross axis.", "zh": "设置子元素在非滚动交叉轴上的位置。" }
        },
        {
          "name": "indicators", "type": "Bool", "default": true,
          "css": { "property": "scrollbar-width", "unit": "keyword", "keywords": { "true": "auto", "false": "none" } },
          "doc": { "en": "Controls whether scrollbars are shown.", "zh": "控制是否显示滚动条。" }
        }
      ]
    },
    {
      "name": "Spacer",
      "doc": { "en": "Occupies space on its parent's main axis without rendering content.", "zh": "占用父容器主轴空间，不绘制内容。" },
      "parents": ["Column", "Row", "Scroll"],
      "members": [
        {
          "name": "size", "type": "Int", "css": { "unit": "custom", "custom": "spacer" },
          "doc": { "en": "Reserves a fixed length; if omitted, shares the remaining space.", "zh": "占用固定长度；未设置时，参与分配剩余空间。" }
        }
      ]
    }
  ]
}
