{
  "name": "@weft-ui/runtime",
  "version": "0.1.0",
  "description": "Weft UI runtime",
  "license": "Apache-2.0",
  "homepage": "https://github.com/MioYiSama/weft-ui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MioYiSama/weft-ui.git",
    "directory": "packages/runtime"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./remote": "./src/remote.ts",
    "./wechat": "./src/wechat.ts",
    "./native": "./src/native.ts",
    "./protocol": "./src/protocol.ts",
    "./testing": "./src/testing.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.js",
      "./remote": "./dist/remote.js",
      "./wechat": "./dist/wechat.js",
      "./native": "./dist/native.js",
      "./protocol": "./dist/protocol.js",
      "./testing": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
