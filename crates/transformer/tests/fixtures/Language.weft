type Kind = "text" | "image"

type Mode = "compact" | "full"

model LanguageItem {
  id: Int,
  kind: Kind,
  name: String,
}

model LanguageModel {
  name: String,
  items: LanguageItem[],
  mode: Mode,
}

component ModeLabel(mode: "compact" | "full" = "full") {
  Text(if (mode == "compact") "C" else "F")
}

component Language(model: LanguageModel) {
  let title = "${model.name} (${model.items.length})"
  Column {
    Text(title)
    ModeLabel(model.mode)
    for (item in model.items; key = item.id) {
      let label = item.name.uppercase()
      Text(label)
      if (item.kind == "image") {
        Text("image")
      } else {
        Text("text")
      }
    }
  }
}
